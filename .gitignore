# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent-roster review scratch — captured diffs only.
# The ledger and its archive are tracked deliberately: they are the loop's
# recovery artifact, and Gemini-based harnesses skip git-ignored paths.
.roster/review/
.superpowers/

# prisma generated client
/src/generated/

# captured mail from E2E runs
/.next/mail.log
